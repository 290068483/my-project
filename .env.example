# 环境变量模板文件
# 复制此文件并重命名为 .env.development 或 .env.production 进行使用

# 应用运行环境
NODE_ENV=

# 应用运行端口
VITE_PORT=

# API基础路径（后端接口地址）
VITE_API_BASE_URL=

# WebSocket基础地址
VITE_WS_BASE_URL=

# 静态资源基础路径
VITE_STATIC_BASE_URL=

# 是否启用Mock
VITE_USE_MOCK=

# 是否开启调试模式
VITE_DEBUG=

# 接口请求超时时间（毫秒）
VITE_TIMEOUT=

# 路由模式（hash/history）
VITE_ROUTER_MODE=

# 可选：CDN地址
VITE_CDN_URL=

# 可选：是否启用性能监控
VITE_ENABLE_PERF_MONITORING=

# 可选：日志级别（error/warn/info/debug）
VITE_LOG_LEVEL=