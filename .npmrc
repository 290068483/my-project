# 使用pnpm作为包管理器
packageManager=pnpm@10.14.0

# 配置依赖安装目录
node_modules=.pnpm/node_modules

# 启用严格模式
strict-peer-dependencies=true

# 配置存储目录
store-dir=.pnpm-store

# 配置全局安装目录
global-dir=~/.pnpm-global

# 配置缓存目录
cache-dir=~/.pnpm-cache

# 自动安装peer依赖
auto-install-peers=true

# 不允许使用npm或yarn安装依赖
engine-strict=true