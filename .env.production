# 生产环境配置
NODE_ENV=production

# 生产环境端口
VITE_PORT=80

# API基础路径（后端接口地址）
VITE_API_BASE_URL=https://api.lanan.com

# WebSocket基础地址
VITE_WS_BASE_URL=wss://api.lanan.com

# 静态资源基础路径（生产环境通常为CDN地址）
VITE_STATIC_BASE_URL=https://cdn.lanan.com/static

# 生产环境是否启用Mock（通常不启用）
VITE_USE_MOCK=false

# 生产环境是否开启调试模式
VITE_DEBUG=false

# 接口请求超时时间（毫秒）
VITE_TIMEOUT=30000

# 路由模式（hash/history）
VITE_ROUTER_MODE=history