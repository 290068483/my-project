# 开发环境端口
VITE_PORT=5173

# API基础路径（后端接口地址）
VITE_API_BASE_URL=http://localhost:3000

# WebSocket基础地址
VITE_WS_BASE_URL=ws://localhost:3000

# 静态资源基础路径（开发环境通常为本地路径）
VITE_STATIC_BASE_URL=/

# 开发环境是否启用Mock
VITE_USE_MOCK=true

# 开发环境是否开启调试模式
VITE_DEBUG=true

# 接口请求超时时间（毫秒）
VITE_TIMEOUT=30000

# 路由模式（hash/history）
VITE_ROUTER_MODE=hash
