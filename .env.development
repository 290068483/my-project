# 开发环境配置
NODE_ENV=development

# API配置
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_BASE_API=/

# 启用Mock数据（解决后端服务未启动的问题）
VITE_USE_MOCK=false

# 调试模式
VITE_DEBUG=true

# 端口配置
VITE_PORT=5173

# 请求超时时间
VITE_TIMEOUT=30000

# 路由模式
VITE_ROUTER_MODE=hash

# 静态资源路径
VITE_STATIC_BASE_URL=/

# WebSocket地址
VITE_WS_BASE_URL=ws://localhost:8080

# 日志级别
VITE_LOG_LEVEL=debug